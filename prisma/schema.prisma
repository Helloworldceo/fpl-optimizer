generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  predictions       Prediction[]
  tablePredictions  TablePrediction[]
  ownedLeagues      League[]           @relation("OwnedLeagues")
  leagueMemberships LeagueMembership[]
}

model League {
  id        String             @id @default(cuid())
  name      String
  code      String             @unique
  ownerId   String
  owner     User               @relation("OwnedLeagues", fields: [ownerId], references: [id])
  members   LeagueMembership[]
  createdAt DateTime           @default(now())
}

model LeagueMembership {
  id       String   @id @default(cuid())
  leagueId String
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([leagueId, userId])
  @@index([userId])
}

// A tiny key-value cache for upstream FPL API responses. Exists because
// Vercel's serverless functions don't reliably reuse the same warm instance
// between requests, so an in-memory cache alone leaves most requests paying
// FPL's full fetch cost again (bootstrap-static alone is a multi-second,
// ~2MB fetch). A DB row survives across every invocation regardless of
// instance reuse, so a cache hit costs one fast Neon round-trip instead.
model FplCache {
  key       String   @id
  data      String
  expiresAt DateTime
}

// One row per user per fixture. Deliberately doesn't store the fixture's
// kickoff time or the actual result — both are looked up live from FPL's
// fixtures API at request time (same "always read live FPL data" pattern
// the rest of this app already follows), so a prediction can't go stale
// relative to e.g. a TV-rescheduled kickoff.
model Prediction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fixtureId     Int
  eventId       Int
  predictedHome Int
  predictedAway Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, fixtureId])
  @@index([eventId])
  @@index([fixtureId])
}

// A user's predicted final league position for one team, for one season.
// One user always has exactly 20 rows for a season — the whole table is
// submitted and replaced together (see submitTablePrediction), never edited
// team-by-team, so there's no window where two teams could momentarily
// share a position. Scored continuously against FPL's live standings
// (see lib/leaderboard.ts) rather than waiting for the season to finish —
// the "final" score is just whatever this looks like on the last day.
model TablePrediction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season    String
  teamId    Int
  position  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, season, teamId])
  @@unique([userId, season, position])
  @@index([userId, season])
}
